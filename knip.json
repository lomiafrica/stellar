{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.ts", "scripts/**/*.ts", "test/**/*.ts", "eslint.config.mjs"],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "eslint.config.mjs"],
  "ignoreDependencies": ["@types/express", "@eslint/js"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  }
}
