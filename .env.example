OMNIBUS_SECRET=
MERCHANT_SECRET=
PUBLIC_BASE_URL=http://localhost:3456
HOME_DOMAIN=localhost
DEMO_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Required on the public lab. Nest sends the same value as STELLAR_LAB_KEY.
# LAB_API_KEY=
# LAB_MAX_USDC_PER_PAYOUT=100
# LAB_MAX_USDC_PER_DAY=500
# CORS_ORIGINS=*
# SEP-10: pnpm sep10:key  (never commit the seed)
SEP10_SIGNING_SEED=
SEP10_SIGNING_PUBLIC_KEY=
SEP10_JWT_SECRET=
CALLBACK_AUTH_SECRET=
SEP24_INTERACTIVE_URL_JWT_SECRET=
ANCHOR_PUBLIC_URL=http://localhost:8080
PLATFORM_API_URL=http://localhost:8085
# Comma-separated G… accounts that SEP-12 may ACCEPT in the lab
SEP12_ACCEPTED_ACCOUNTS=
# Production: existing merchant verification
# LOMI_MERCHANT_VERIFY_URL=
EUR_USD_RATE=1.08
QUOTE_SPREAD_BPS=50
# Live tests (never put OMNIBUS_SECRET in CI)
# LIVE_LAB_URL=https://lab-production-5fac.up.railway.app
# LIVE_ANCHOR_URL=https://anchor-production-5059.up.railway.app
# LIVE_USDC_AMOUNT=1
# LAB_API_KEY=
# RSA public key for POST /bridge/webhook (Bridge per-endpoint PEM). Unsigned webhooks are refused.
# BRIDGE_WEBHOOK_PUBLIC_KEY=
# Bridge sandbox. Unset BRIDGE_API_KEY keeps the mock adapter.
# BRIDGE_API_URL=https://api.sandbox.bridge.xyz
# BRIDGE_API_KEY=
# BRIDGE_CUSTOMER_ID=
# BRIDGE_VIRTUAL_ACCOUNT_ID=
# BRIDGE_WEBHOOK_ID=
# BRIDGE_CUSTOMER_EMAIL=
# Ledger directory. On Railway this is the volume mount.
# STELLAR_DATA_DIR=/data
# RECONCILE_CRON_HOURS=24
# ALERT_WEBHOOK_URL=
# SEP6_POLL_SECONDS=60
# SEP6_DRIVE_SEND=1
